      "accent": "#06d6a0",
      "background": "#ffffff",
      "light_bg": "#ecfdf5",
      "text": "#064e3b",
      "text_secondary": "#6b7280",
      "text_light": "#ffffff",
      "border": "#d1fae5"
    },
    "fonts": {
      "title": "Arial",
